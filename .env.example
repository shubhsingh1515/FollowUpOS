# ====================================================================
# FollowUpOS — AI Sales Follow-Up SaaS Production Environment Configuration
# ====================================================================

NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/followupos?retryWrites=true&ww=majority

# Authentication Secrets (Generate strong random 64-char strings in production)
JWT_ACCESS_SECRET=your-super-secret-jwt-access-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-key-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# AES-256-GCM Token Encryption Key (64-character hex string)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Demo Mode — set to false in real production to enforce live integrations & API keys
DEMO_MODE=true

# ====================================================================
# SUPER ADMIN PLATFORM BOOTSTRAP
# Run: npm run create-super-admin (inside /server)
# ====================================================================
SUPER_ADMIN_EMAIL=admin@followupos.com
SUPER_ADMIN_PASSWORD=SuperAdmin@Secure2026!
SUPER_ADMIN_BOOTSTRAP_SECRET=super-admin-bootstrap-secret-change-in-prod

# ====================================================================
# BILLING & PAYMENTS (Razorpay Primary for INR / Stripe Secondary)
# ====================================================================
BILLING_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretHere
RAZORPAY_WEBHOOK_SECRET=YourRazorpayWebhookSecretHere

# Razorpay Plan IDs (Created in Razorpay Dashboard > Subscriptions)
RAZORPAY_PLAN_STARTER=plan_StarterMonthly_999
RAZORPAY_PLAN_GROWTH=plan_GrowthMonthly_2999
RAZORPAY_PLAN_AGENCY=plan_AgencyMonthly_7999

# Stripe Alternative (Optional)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_GROWTH=price_...
STRIPE_PRICE_AGENCY=price_...

# ====================================================================
# AI PROVIDERS (OpenAI & Fallback)
# ====================================================================
AI_PROVIDER=openai
OPENAI_API_KEY=sk-proj-YourOpenAIApiKey
OPENAI_MODEL=gpt-4o-mini

# ====================================================================
# TRANSACTIONAL EMAIL (SMTP, Sendgrid, or Mock in Development)
# ====================================================================
EMAIL_PROVIDER=mock
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@followupos.com
SMTP_PASSWORD=your-app-specific-password
EMAIL_FROM="FollowUpOS" <notifications@followupos.com>

# ====================================================================
# INTEGRATION CHANNELS (Public Webhooks & OAuth)
# ====================================================================

# WhatsApp Business Cloud API (Meta for Developers)
WHATSAPP_ACCESS_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=109283746592837
WHATSAPP_BUSINESS_ACCOUNT_ID=982736451029384
WHATSAPP_VERIFY_TOKEN=followupos-whatsapp-verify-token-2026
WHATSAPP_APP_SECRET=your_meta_app_secret

# Meta Lead Ads (Facebook & Instagram)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:5000/api/integrations/meta/callback
META_WEBHOOK_VERIFY_TOKEN=followupos-meta-verify-token-2026

# Calendly Scheduling Webhooks
CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=
CALENDLY_REDIRECT_URI=http://localhost:5000/api/integrations/calendly/callback
CALENDLY_WEBHOOK_SIGNING_KEY=

# Google OAuth (Gmail & Google Calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/integrations/google/callback

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:5000/api/integrations/linkedin/callback

# Optional Redis Cache / Queue
REDIS_URL=redis://localhost:6379
