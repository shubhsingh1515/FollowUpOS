# ====================================================================
# FollowUpOS — AI Sales Follow-Up SaaS Production Environment Configuration
# ====================================================================

NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/followupos?retryWrites=true&w=majority

# Authentication Secrets
JWT_ACCESS_SECRET=your-super-secret-jwt-access-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-key-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# AES-256-GCM Token Encryption Key (64-character hex string)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Demo Mode — set to false in real production to enforce live integrations & API keys
DEMO_MODE=true

# Super Admin Platform Bootstrap (npm run create-super-admin)
SUPER_ADMIN_EMAIL=admin@followupos.com
SUPER_ADMIN_PASSWORD=SuperAdmin@Secure2026!
SUPER_ADMIN_BOOTSTRAP_SECRET=super-admin-bootstrap-secret-change-in-prod

# Billing & Subscriptions (Razorpay Primary for INR)
BILLING_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretHere
RAZORPAY_WEBHOOK_SECRET=YourRazorpayWebhookSecretHere
RAZORPAY_PLAN_STARTER=plan_StarterMonthly_999
RAZORPAY_PLAN_GROWTH=plan_GrowthMonthly_2999
RAZORPAY_PLAN_AGENCY=plan_AgencyMonthly_7999

# AI Configuration
AI_PROVIDER=openai
OPENAI_API_KEY=sk-proj-YourOpenAIApiKey
OPENAI_MODEL=gpt-4o-mini

# Transactional Email (mock, smtp, sendgrid)
EMAIL_PROVIDER=mock
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@followupos.com
SMTP_PASSWORD=your-app-specific-password
EMAIL_FROM="FollowUpOS" <notifications@followupos.com>

# Channels & Webhooks
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=followupos-whatsapp-verify-token-2026
WHATSAPP_APP_SECRET=
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=followupos-meta-verify-token-2026
# Google OAuth 2.0 / OpenID Connect (Platform Owner Credentials - Never share with customers)
# Obtain from Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Additional Channel Integrations (Optional)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

