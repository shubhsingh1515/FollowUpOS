# ====================================================================
# FollowUpOS Client — Frontend Environment Configuration
# ====================================================================

# Backend API Base URL
VITE_API_URL=https://api-followupos.onrender.com/api

# Public Marketing & App Root URL
VITE_APP_URL=https://new-followupos.onrender.com

# Demo Mode Toggle (true for local development with mock credentials)
VITE_DEMO_MODE=true

# CRITICAL SECURITY NOTE:
# Never put private server secrets, database URIs, encryption keys,
# or payment gateway secrets in VITE_* environment variables.
# Anything prefixed with VITE_ is bundled into client-side JavaScript.
